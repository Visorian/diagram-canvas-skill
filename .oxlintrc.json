{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "vue", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "browser": true
  },
  "options": {
    "typeAware": true
  },
  "ignorePatterns": ["dist/**", ".playwright-cli/**", "dist-vdom/**"],
  "rules": {
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "virtual:uno.css"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["bench/*.js"],
      "rules": {
        "no-unused-expressions": "off",
        "no-await-in-loop": "off",
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ]
}

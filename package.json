{
  "name": "vue-vapor-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@vue-flow/core": "1.48.2",
    "vue": "3.6.0-rc.9"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.17.tsgo.7.0.2",
    "unocss": "66.10.5",
    "vite": "8.3.0",
    "vue-tsc": "3.3.11"
  },
  "packageManager": "bun@1.4.2"
}
